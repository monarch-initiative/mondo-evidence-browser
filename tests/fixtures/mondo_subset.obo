property_value: skos:exactMatch MEDGEN:1373306
property_value: skos:exactMatch NCIT:C38342
property_value: skos:exactMatch UMLS:C4511687

[Term]
id: MONDO:0004790
name: fatty liver disease
def: "A reversible condition wherein large vacuoles of triglyceride fat accumulate in liver cells via the process of steatosis." [Wikipedia:Fatty_liver]
