# Copy to .env (gitignored) and fill in. `just build` and `just serve` load it.

# ORCID API client id (public; not a secret). Register at sandbox.orcid.org for
# testing, orcid.org for production. Never put the client secret here: nothing uses it.
ORCID_CLIENT_ID=
# https://sandbox.orcid.org (testing) or https://orcid.org (production)
ORCID_BASE_URL=https://sandbox.orcid.org

# Optional: a sign-off service on another host (the Pages build), and data files
# hosted outside the site (see README, Deploying).
# MEB_SERVICE_URL=
# MEB_DATA_URL=
# MEB_ALLOWED_ORIGINS=
